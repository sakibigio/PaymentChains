###########################

# compiled packages
.julia/compiled/
.julia/packages/
.julia/environments/*/Manifest.toml
.julia/environments/*/Project.toml

# project environments
Manifest.toml
Project.toml

# Jupyter notebooks (optional)
*.ipynb_checkpoints/

